# Copy to .env for local scripts (smoke test, ingestion, evals; loaded by dotenv). Never commit real values.
# Edge Functions read the same names from InsForge secrets:
#   npx -y @insforge/cli secrets add SARVAM_API_KEY <value>

# InsForge (from .insforge/project.json / dashboard)
INSFORGE_BASE_URL=https://r2f4a6w6.ap-southeast.insforge.app
INSFORGE_ANON_KEY=
# Admin key: server-only, used by local ingestion scripts. Never ship to the frontend.
INSFORGE_API_KEY=

# Sarvam Token Factory (OpenAI-compatible)
SARVAM_API_KEY=
SARVAM_BASE_URL_V2=https://api.sarvam.ai/v2
SARVAM_BASE_URL_V1=https://api.sarvam.ai/v1

# Embeddings: not used yet. Retrieval is keyword search; vectors (vector(768),
# Sarvam embeddinggemma-2) come later once Sarvam enables provisioned access.

# Edge Function CORS (frontend origin in production)
ALLOWED_ORIGIN=http://localhost:3000
